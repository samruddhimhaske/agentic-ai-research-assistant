# ============================================================
# AI Research Assistant Agent - Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to GitHub!
# ============================================================

# --- OpenAI API Key ---
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# --- Model Selection ---
# Recommended for beginners (affordable + powerful):
MODEL_NAME=gpt-4o-mini

# --- App Settings ---
DEBUG=True
APP_HOST=0.0.0.0
APP_PORT=8000

# --- CORS Settings ---
# In production, replace * with your actual frontend URL
# Example: ALLOWED_ORIGINS=https://my-frontend.vercel.app
ALLOWED_ORIGINS=*

# --- Agent Settings ---
# Maximum number of agent thinking loops before it stops
MAX_ITERATIONS=5

# --- History Settings ---
# How many previous queries to remember
MAX_HISTORY_SIZE=50
